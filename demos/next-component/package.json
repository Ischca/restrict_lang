{
  "name": "restrict-next-component-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "restrict:build": "cd ../.. && mise exec -- cargo run --locked -p warder -- --project demos/next-component/restrict build --component",
    "component:transpile": "jco transpile restrict/dist/restrict-next-demo-0.1.0.component.wasm -o generated/restrict --name restrict --no-wasi-shim --no-namespaced-exports --base64-cutoff=1000000",
    "component": "pnpm restrict:build && pnpm component:transpile",
    "predev": "pnpm component",
    "dev": "next dev",
    "prebuild": "pnpm component",
    "build": "next build",
    "start": "next start",
    "check:server-boundary": "node scripts/check-server-boundary.mjs",
    "smoke": "node scripts/smoke-component.mjs",
    "verify": "pnpm build && pnpm check:server-boundary && pnpm smoke"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@bytecodealliance/jco": "1.17.9",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
