{
    "name": "restrict-language",
    "displayName": "Restrict Language",
    "description": "Language support for Restrict Language - A functional programming language with affine types for WebAssembly",
    "version": "0.1.0",
    "packageManager": "pnpm@11.2.1",
    "publisher": "restrict-lang",
    "icon": "images/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ischca/restrict_lang"
    },
    "homepage": "https://ischca.github.io/restrict_lang/docs/",
    "bugs": {
        "url": "https://github.com/Ischca/restrict_lang/issues"
    },
    "engines": {
        "vscode": "^1.74.0"
    },
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "The extension starts the configured Restrict compiler from the workspace extension host."
        },
        "virtualWorkspaces": false
    },
    "categories": [
        "Programming Languages",
        "Syntax Highlighting"
    ],
    "keywords": [
        "restrict",
        "functional",
        "webassembly",
        "affine types"
    ],
    "activationEvents": [
        "onLanguage:restrict",
        "onCommand:restrict.compile",
        "onCommand:restrict.typeCheck",
        "onCommand:restrict.showAST",
        "onCommand:restrict.gotoDefinition",
        "onCommand:restrict.findReferences",
        "onCommand:restrict.showHover",
        "onCommand:restrict.showDocumentSymbols",
        "onCommand:restrict.restartLanguageServer"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "restrict",
                "aliases": [
                    "Restrict Language",
                    "restrict"
                ],
                "extensions": [
                    ".rl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "restrict",
                "scopeName": "source.restrict",
                "path": "./syntaxes/restrict.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "restrict",
                "path": "./snippets/restrict.json"
            }
        ],
        "commands": [
            {
                "command": "restrict.compile",
                "title": "Compile Restrict File",
                "category": "Restrict"
            },
            {
                "command": "restrict.typeCheck",
                "title": "Type Check Restrict File",
                "category": "Restrict"
            },
            {
                "command": "restrict.showAST",
                "title": "Show AST",
                "category": "Restrict"
            },
            {
                "command": "restrict.gotoDefinition",
                "title": "Go to Definition",
                "category": "Restrict"
            },
            {
                "command": "restrict.findReferences",
                "title": "Find All References",
                "category": "Restrict"
            },
            {
                "command": "restrict.showHover",
                "title": "Show Hover Info",
                "category": "Restrict"
            },
            {
                "command": "restrict.showDocumentSymbols",
                "title": "Show Document Symbols",
                "category": "Restrict"
            },
            {
                "command": "restrict.restartLanguageServer",
                "title": "Restart Language Server",
                "category": "Restrict"
            }
        ],
        "keybindings": [
            {
                "command": "restrict.compile",
                "key": "ctrl+shift+b",
                "when": "editorLangId == restrict"
            },
            {
                "command": "restrict.typeCheck",
                "key": "ctrl+shift+t",
                "when": "editorLangId == restrict"
            },
            {
                "command": "restrict.gotoDefinition",
                "key": "f12",
                "when": "editorLangId == restrict"
            },
            {
                "command": "restrict.findReferences",
                "key": "shift+f12",
                "when": "editorLangId == restrict"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorLangId == restrict",
                    "command": "restrict.compile",
                    "group": "restrict"
                },
                {
                    "when": "editorLangId == restrict",
                    "command": "restrict.typeCheck",
                    "group": "restrict"
                },
                {
                    "when": "editorLangId == restrict",
                    "command": "restrict.showAST",
                    "group": "restrict"
                }
            ]
        },
        "themes": [
            {
                "label": "Restrict Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/restrict-dark.json"
            },
            {
                "label": "Restrict Light",
                "uiTheme": "vs",
                "path": "./themes/restrict-light.json"
            }
        ],
        "iconThemes": [
            {
                "id": "restrict-icons",
                "label": "Restrict File Icons",
                "path": "./icons/restrict-icon-theme.json"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Restrict Language",
            "properties": {
                "restrict.compilerPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "Path to the Restrict compiler used by CLI fallbacks and, when no server path is set, by the language client. Leave empty to use a development build or 'restrict_lang' from PATH."
                },
                "restrict.enableTypeChecking": {
                    "type": "boolean",
                    "default": true,
                    "description": "Run a CLI type check on save when the language server is disabled or unavailable. The language server publishes live diagnostics independently."
                },
                "restrict.languageServerPath": {
                    "type": "string",
                    "default": "",
                    "scope": "machine-overridable",
                    "description": "Path to the Restrict compiler executable used as the language server. The extension starts it with --lsp."
                },
                "restrict.enableLSP": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable live diagnostics, scoped completion, hover, cross-file definitions and references, reference CodeLens, inlay hints, document symbols, and semantic highlighting. Reload or run Restart Language Server after changing this setting."
                }
            }
        }
    },
    "scripts": {
        "check-types": "tsc -p ./ --noEmit",
        "bundle": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap --minify",
        "compile": "pnpm check-types && pnpm bundle",
        "watch": "esbuild ./src/extension.ts --bundle --outfile=./out/extension.js --external:vscode --format=cjs --platform=node --target=node16 --sourcemap --watch",
        "test:lsp": "node ./scripts/smoke-lsp.mjs",
        "package": "pnpm compile && vsce package --no-dependencies",
        "publish": "pnpm compile && vsce publish --no-dependencies"
    },
    "dependencies": {
        "vscode-languageclient": "^8.1.0"
    },
    "devDependencies": {
        "@types/node": "16.x",
        "@types/vscode": "1.74.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.28.1",
        "typescript": "^4.9.4"
    }
}
